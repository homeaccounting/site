---
import Base from '../layouts/Base.astro';
import { SECURITY_MD_URL, SELFHOST_URL, cloudCta } from '../config';
const cta = cloudCta();
const pillars = [
  [
    'Encrypted at rest',
    'Bank credentials and tokens are encrypted at rest — never stored in plaintext.',
  ],
  [
    'Self-host = your server',
    'Run it entirely on your own machine; your data never has to touch our servers.',
  ],
  [
    'Open source (AGPL)',
    'The whole thing is auditable. Read the code, verify the claims, or fork it.',
  ],
  [
    'A real disclosure route',
    'Private vulnerability reporting on every repository, a published security contact, and coordinated disclosure.',
  ],
];
---

<Base
  title="Security"
  description="How HomeAccounting protects your money: encrypted at rest, self-hostable, open source, with a real disclosure route."
>
  <section class="container py-20 max-w-3xl">
    <h1 class="text-4xl font-bold">Security &amp; privacy at HomeAccounting</h1>
    <p class="mt-4 text-lg text-muted-foreground">
      Trust is the product. Here is exactly how your money is handled — and how
      to verify it yourself.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        pillars.map(([h, p]) => (
          <div class="rounded-lg border border-border p-6">
            <h2 class="font-semibold">{h}</h2>
            <p class="mt-2 text-muted-foreground">{p}</p>
          </div>
        ))
      }
    </div>

    <h2 class="mt-14 text-2xl font-bold">Responsible disclosure</h2>
    <p class="mt-3 text-muted-foreground">
      Found a vulnerability? Report it privately — through GitHub&rsquo;s private
      vulnerability reporting on any of our repositories, or by email to <a
        class="underline"
        href="mailto:security@homeaccounting.com">security@homeaccounting.com</a
      >. We acknowledge within 3 business days and coordinate disclosure with
      you.
    </p>
    <p class="mt-3">
      <a class="underline" href={SECURITY_MD_URL}
        >SECURITY.md &amp; disclosure policy →</a
      >
    </p>

    <div class="mt-14 rounded-lg border border-border bg-card p-8">
      <h2 class="text-xl font-bold">Don't trust us? Run it yourself.</h2>
      <div class="mt-4 flex gap-4">
        <a
          href={SELFHOST_URL}
          class="rounded-md border border-border px-5 py-3 font-medium"
          >Self-host</a
        >
        <a
          href={cta.href}
          class="rounded-md bg-primary text-primary-foreground px-5 py-3 font-medium"
          >{cta.label}</a
        >
      </div>
    </div>
  </section>
</Base>
