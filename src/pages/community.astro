---
// Canonical community URL. Every repo — READMEs, CONTRIBUTING, issue-template
// contact links — points here rather than at a platform invite, so invites can
// be rotated, and platforms added or dropped, in one place.
import Base from '../layouts/Base.astro';
import { DISCORD_INVITE, TELEGRAM_INVITE, DISCUSSIONS_URL } from '../config';

const venues: {
  name: string;
  href: string;
  lang?: string;
  lead: string;
  detail: string;
}[] = [
  {
    name: 'Discord',
    href: DISCORD_INVITE,
    lead: 'Real-time help and general chat, in English.',
    detail:
      'Self-hosting questions, bank-provider work, and whatever else comes up. The fastest way to reach other users and the maintainers.',
  },
  {
    name: 'Telegram',
    href: TELEGRAM_INVITE,
    // The whole document is lang="en"; this line is not, and a screen reader
    // will mangle it with an English voice without the override.
    lang: 'uk',
    lead: 'Українською — для користувачів monobank та ПриватБанку.',
    detail:
      'Releases and updates in Ukrainian, on the platform the capture feature already lives in. Comments are open under every post.',
  },
  {
    name: 'GitHub Discussions',
    href: DISCUSSIONS_URL,
    lead: 'Questions worth keeping.',
    detail:
      'Anything a future reader might search for: how-to questions, requests for a new bank, and ideas. Answers here stay findable; chat does not.',
  },
].filter((v) => v.href);
---

<Base
  title="Community"
  description="Where to find the HomeAccounting community: Discord, Telegram, and GitHub Discussions."
>
  <section class="container py-20 max-w-3xl">
    <h1 class="text-4xl font-bold">Community</h1>
    <p class="mt-4 text-lg text-muted-foreground">
      Three rooms, on purpose. Chat is fast but disappears; Discussions are slow
      but stay findable for the next person with the same question.
    </p>

    <div class="mt-10 grid gap-6">
      {
        venues.map((v) => (
          <a
            class="rounded-lg border border-border p-6 hover:border-foreground/40"
            href={v.href}
            rel="noopener"
          >
            <h2 class="font-semibold">{v.name}</h2>
            <p class="mt-1" lang={v.lang}>
              {v.lead}
            </p>
            <p class="mt-2 text-muted-foreground">{v.detail}</p>
          </a>
        ))
      }
    </div>

    <p class="mt-10 text-muted-foreground">
      Found a security vulnerability? Please do not post it in any of these.
      Email <a class="underline" href="mailto:security@homeaccounting.com"
        >security@homeaccounting.com</a
      > — see the security policy for what to expect.
    </p>
  </section>
</Base>
