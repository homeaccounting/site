---
import { SECTION } from '../config';

// Simple 24x24 stroke icons, inlined so no extra request/dep.
const icons = {
  bank: '<polyline points="4 10 12 4 20 10" /><line x1="4" y1="10" x2="20" y2="10" /><line x1="4" y1="20" x2="20" y2="20" /><line x1="6" y1="10" x2="6" y2="18" /><line x1="10" y1="10" x2="10" y2="18" /><line x1="14" y1="10" x2="14" y2="18" /><line x1="18" y1="10" x2="18" y2="18" />',
  chat: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H9l-4 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" /><line x1="7" y1="9" x2="17" y2="9" stroke-linecap="round" /><line x1="7" y1="12.5" x2="14" y2="12.5" stroke-linecap="round" />',
  send: '<line x1="22" y1="2" x2="11" y2="13" stroke-linecap="round" stroke-linejoin="round" /><polygon points="22 2 15 22 11 13 2 9 22 2" stroke-linejoin="round" />',
};

const methods = [
  {
    h: 'Bank import',
    kw: 'It logs itself',
    p: 'Direct <strong>monobank</strong> sync + <strong>PrivatBank</strong> / file import (CSV, XLSX). Categorized on arrival — you just confirm.',
    icon: icons.bank,
  },
  {
    h: 'Free-text prompt',
    kw: 'Type a sentence',
    p: '"coffee 45, taxi 200, groceries 380" becomes real transactions with accounts & categories.',
    icon: icons.chat,
  },
  {
    h: 'Telegram',
    kw: 'Just text it',
    p: 'The same capture from the <strong>Telegram</strong> chat you already have open — the reason it sticks.',
    icon: icons.send,
  },
];
---

<section id={SECTION.capture} class="bg-muted/40">
  <div class="container py-16">
    <h2 class="text-sm uppercase tracking-wide text-muted-foreground">
      Three ways to capture
    </h2>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {
        methods.map((m) => (
          <article class="rounded-lg bg-card border border-border shadow-lg p-6">
            <div class="mb-4 aspect-video rounded-md bg-muted grid place-items-center text-xs text-muted-foreground">
              screenshot — coming soon
            </div>
            <div
              class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-positive/10 text-positive"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="w-5 h-5"
                set:html={m.icon}
              />
            </div>
            <p class="mt-3 text-sm text-muted-foreground">{m.kw}</p>
            <h3 class="mt-1 text-xl font-semibold">{m.h}</h3>
            {/* m.p is a hardcoded, author-controlled literal (not user/external data) — raw HTML injection is safe here. */}
            <p class="mt-2 text-muted-foreground" set:html={m.p} />
          </article>
        ))
      }
    </div>
  </div>
</section>
