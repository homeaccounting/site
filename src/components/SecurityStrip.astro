---
import { SECURITY_MD_URL } from '../config';
---

<section class="container py-16">
  <div class="rounded-lg border border-border bg-card p-8">
    <h2 class="text-2xl font-bold">Security &amp; privacy, provably</h2>
    <p class="mt-3 text-muted-foreground">
      Bank credentials <strong>encrypted at rest</strong> · open source (AGPL) · export
      &amp; leave anytime · responsible-disclosure policy.
    </p>
    <div class="mt-5 flex gap-4">
      <a
        href="/security"
        class="rounded-md bg-primary text-primary-foreground px-5 py-3 font-medium"
        >How we handle your money →</a
      >
      <a
        href={SECURITY_MD_URL}
        class="rounded-md border border-border px-5 py-3 font-medium"
        >SECURITY.md</a
      >
    </div>
  </div>
</section>
