---
import { FOOTER } from '../config';
import Logo from './Logo.astro';
---

<footer class="border-t border-border mt-24">
  <div
    class="container py-10 grid gap-8 md:grid-cols-4 text-sm text-muted-foreground"
  >
    <div>
      <a href="/" class="flex items-center gap-2 font-semibold text-foreground">
        <Logo class="w-6 h-6" />
        <span>HomeAccounting</span>
      </a>
      <p class="mt-2">Your money, your server, your data.</p>
    </div>
    {
      FOOTER.map((col) => (
        <div>
          <p class="font-medium text-foreground">{col.heading}</p>
          {col.links.map((l, i) => (
            <a class={`block${i === 0 ? ' mt-2' : ''}`} href={l.href}>
              {l.label}
            </a>
          ))}
          {col.notes.map((n, i) => (
            <span
              class={`block${col.links.length === 0 && i === 0 ? ' mt-2' : ''}${n.muted ? ' opacity-50' : ''}`}
            >
              {n.label}
            </span>
          ))}
        </div>
      ))
    }
  </div>
</footer>
