---
import { cloudCta, DOCS_URL, SECTION } from '../config';
const cta = cloudCta();
const parity = [
  'bank import',
  'prompt',
  'Telegram',
  'multi-currency',
  'export',
];
---

<section id={SECTION.hosting} class="container py-16">
  <h2 class="text-3xl font-bold">Same product — you choose who runs it</h2>
  <div class="mt-8 grid gap-6 md:grid-cols-2">
    <div class="rounded-lg border border-border p-6">
      <h3 class="text-xl font-semibold">🖥️ Self-host</h3>
      <ul class="mt-4 space-y-2 text-muted-foreground">
        <li>One command (Docker Compose)</li>
        <li>Free forever</li>
        <li>Data never leaves your machine</li>
        <li>You control updates</li>
      </ul>
      <a
        href={DOCS_URL}
        class="mt-6 inline-block rounded-md border border-border px-5 py-3 font-medium"
        >Self-host / View on GitHub →</a
      >
    </div>
    <div class="rounded-lg border border-border p-6 bg-card">
      <h3 class="text-xl font-semibold">☁️ Free cloud</h3>
      <ul class="mt-4 space-y-2 text-muted-foreground">
        <li>Nothing to install</li>
        <li>Free while in beta</li>
        <li>Encrypted at rest; export anytime</li>
        <li>Automatic updates</li>
      </ul>
      <a
        href={cta.href}
        class="mt-6 inline-block rounded-md bg-primary text-primary-foreground px-5 py-3 font-medium"
        >{cta.label} →</a
      >
    </div>
  </div>
  <p class="mt-6 text-sm text-muted-foreground">
    Same on both — {parity.join(' · ')} ✓. The only difference is who operates it,
    and <strong>you can move between them</strong> anytime (export/import).
  </p>
</section>
