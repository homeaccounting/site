---
import { cloudCta, DEMO_URL, DOCS_URL } from '../config';
const cta = cloudCta();
---

<section class="container py-20 grid gap-12 lg:grid-cols-2 items-center">
  <div>
    <h1
      class="text-4xl md:text-5xl font-bold tracking-tight text-balance animate-fade-up"
    >
      Logging money takes seconds — or nothing at all. And it
      <span class="text-positive">stays yours</span>.
    </h1>
    <ul
      class="mt-8 space-y-3 text-lg text-muted-foreground animate-fade-up [animation-delay:100ms]"
    >
      <li>
        <strong class="text-foreground">Almost no manual entry</strong> —
        <strong>monobank</strong> and <strong>PrivatBank</strong> bring in your transactions,
        a plain-text sentence, or a <strong>Telegram</strong>
        message.
      </li>
      <li>
        <strong class="text-foreground">Your money, your data</strong>
        — self-host or free cloud, open source (AGPL), export anytime.
      </li>
    </ul>
    <div
      class="mt-8 flex flex-wrap items-center gap-4 animate-fade-up [animation-delay:200ms]"
    >
      <a
        href={cta.href}
        class="rounded-md bg-primary text-primary-foreground px-5 py-3 font-medium transition-colors hover:bg-primary/90"
        >{cta.label}</a
      >
      <a
        href={DOCS_URL}
        class="rounded-md border border-border px-5 py-3 font-medium transition-colors hover:border-positive hover:text-positive"
        >Self-host / GitHub</a
      >
      <a
        href={DEMO_URL}
        class="text-sm underline transition-colors hover:text-positive"
        >Try the live demo →</a
      >
    </div>
  </div>
  <div
    class="rounded-xl border border-border shadow-2xl overflow-hidden bg-card"
  >
    <div class="h-8 bg-muted flex items-center gap-1.5 px-3">
      <span class="w-2.5 h-2.5 rounded-full bg-muted-foreground/30"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-muted-foreground/30"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-muted-foreground/30"></span>
    </div>
    <img
      src="/hero.png"
      alt="HomeAccounting transactions view — accounts and a categorized transaction list"
      width="1280"
      height="720"
      class="w-full aspect-video object-cover"
    />
  </div>
</section>
