---
import { cloudCta, NAV_LINKS } from '../config';
const cta = cloudCta();
---

<header class="border-b border-border">
  <nav class="container flex items-center justify-between h-16">
    <a href="/" class="font-semibold text-lg">◆ HomeAccounting</a>
    <div
      class="hidden md:flex items-center gap-6 text-sm text-muted-foreground"
    >
      {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    <a
      href={cta.href}
      class="rounded-md bg-primary text-primary-foreground px-4 py-2 text-sm font-medium"
      >{cta.label}</a
    >
  </nav>
</header>
