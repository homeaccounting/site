---
// Shared app logo mark (green line-art house). Reused by Nav and Footer;
// same asset also serves as the favicon. Decorative — the adjacent
// "HomeAccounting" wordmark carries the name.
interface Props {
  class?: string;
}
const { class: className = 'w-7 h-7' } = Astro.props;
---

<img
  src="/logo.png"
  alt=""
  aria-hidden="true"
  width="32"
  height="32"
  class={className}
/>
